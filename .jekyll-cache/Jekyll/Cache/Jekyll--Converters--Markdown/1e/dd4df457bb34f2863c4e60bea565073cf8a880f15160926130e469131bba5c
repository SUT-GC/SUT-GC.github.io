            <span class="nx">r</span> <span class="o">+=</span> <span class="nx">count</span> <span class="o">+</span> <span class="dl">""</span> <span class="o">+</span> <span class="nx">nowNumber</span>
            <span class="nx">count</span> <span class="o">=</span> <span class="mi">1</span>
            <span class="nx">nowNumber</span> <span class="o">=</span> <span class="nx">numS</span><span class="p">[</span><span class="nx">i</span><span class="p">]</span>
        <span class="p">}</span>
    <span class="p">}</span>

    <span class="nx">r</span> <span class="o">+=</span> <span class="nx">count</span> <span class="o">+</span> <span class="dl">""</span> <span class="o">+</span> <span class="nx">nowNumber</span>

